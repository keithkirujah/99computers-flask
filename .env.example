# Set only in local environment / Vercel Environment Variables. Never commit real values.
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_USERNAME=choose-admin-username
ADMIN_PASSWORD=replace-with-unique-password-at-least-12-characters
GITHUB_OWNER=your-testing-github-owner
GITHUB_REPO=your-testing-repository
GITHUB_BRANCH=main
GITHUB_TOKEN=github-token-restricted-to-testing-repository
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional first-run seed accounts only; then manage accounts in /staff.html
SITE_USERNAME=
SITE_PASSWORD=
STAFF_USERNAME=
STAFF_PASSWORD=
